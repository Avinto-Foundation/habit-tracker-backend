# Copy this file to .env and fill in your own values. Never commit .env.

# Django
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# (no "$" in it: Docker Compose would treat "$..." as a variable and change the key)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (with Docker, DB_HOST/DB_PORT are set to the "db" container
# automatically; DB_NAME, DB_USER and DB_PASSWORD are used to create it)
DB_NAME=habit_tracker
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Frontend URL(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google sign-in: OAuth Client ID from Google Cloud Console (same as the frontend's
# VITE_GOOGLE_CLIENT_ID). Leave empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=

# Frontend address, used for links in emails (e.g. reset password)
FRONTEND_URL=http://localhost:5173

# Email. By default emails are printed in the runserver terminal (nothing is sent).
# To really send with Gmail: create an App Password (Google Account > Security >
# 2-Step Verification > App passwords) and uncomment/fill these:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=HabitSquad <your-address@gmail.com>
